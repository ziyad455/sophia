NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sophia
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=sophia-api
JWT_AUDIENCE=sophia-web
ACCESS_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_COOKIE_NAME=sophia_access_token
REFRESH_TOKEN_COOKIE_NAME=sophia_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=localhost
UPLOAD_DIR=storage/uploads
MAX_PDF_UPLOAD_MB=50

# Gemini is optional until the AI runtime is explicitly composed.
# GEMINI_API_KEY=replace-with-a-server-side-api-key
# GEMINI_MODEL=replace-with-a-stable-gemini-model-id
# GEMINI_REQUEST_TIMEOUT_MS=30000
